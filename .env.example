GROQ_API_KEY=
TAVILY_API_KEY=
# Optional — defaults to openai/gpt-oss-120b if unset
GROQ_MODEL=

# LLM provider fallback chain (agent/llm_fallback.py) — Groq -> Gemini ->
# Mistral -> OpenRouter. All 3 required for the fallback chain to have
# somewhere to go if Groq fails.
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# Optional — see agent/llm_fallback.py for defaults and why each was chosen
GEMINI_MODEL=
MISTRAL_MODEL=
OPENROUTER_MODEL=

# OCR fallback for scan-only PDFs (agent/ocr.py) — uses the same
# MISTRAL_API_KEY above, via a second Python package (mistralai, the raw
# SDK) since OCR/Batch/Files are outside langchain-mistralai's chat-only
# wrapper. Optional — defaults to mistral-ocr-latest if unset.
MISTRAL_OCR_MODEL=
